package brain.workLoop; class WorkComponent { public var mTasks = new haxe.ds.ObjectMap<Dynamic,Dynamic>(); public var mWorkLoopManager = new WorkLoopManager(); public var gameClock:Dynamic = {}; public function new() {} public function doLater(delay:Float,cb:Dynamic):DoLater {var t=new DoLater(cb);t.delay=delay;t.dueTime=mWorkLoopManager.now+delay*1000;mWorkLoopManager.doLaterQueue.add(t);mTasks.set(t,true);return t;} }