package brain.workLoop; class WorkLoopManager { public var doLaterQueue = new DoLaterQueue(); public var now:Float = 0; public function new() {} public function removeDoLater(t:DoLater):Bool {t.dead=true;t.callback=null;return doLaterQueue.remove(t);} /** As the game does: a task that has run stays undestroyed, in its component's tasks. */ public function advance(to:Float, clock:Dynamic):Void { now=to; var t; while ((t=doLaterQueue.due(now))!=null) if (!t.isDestroyed() && t.callback!=null) t.callback(clock); } }
class DoLaterQueue { var items:Array<DoLater> = []; public function new() {} public function add(t:DoLater):Void {items.push(t);} public function contains(t:Dynamic):Bool {return items.indexOf(t)>=0;} public function remove(t:DoLater):Bool {return items.remove(t);} public function due(now:Float):DoLater { var best:DoLater=null; for (t in items) if (t.dueTime<=now && (best==null || t.dueTime<best.dueTime)) best=t; if (best!=null) items.remove(best); return best; } }